rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() <= 120;
    }

    function isAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStationId(val) {
      return isValidId(val);
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(val) {
      return val is string && val.size() == 5 && val.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidEmailStr(val) {
      return val is string
        && val.size() >= 3
        && val.size() <= 120
        && val.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidEmailList(listVal) {
      return listVal is list
        && listVal.size() >= 1
        && listVal.size() <= 15
        && isValidEmailStr(listVal[0])
        && (listVal.size() < 2 || isValidEmailStr(listVal[1]))
        && (listVal.size() < 3 || isValidEmailStr(listVal[2]))
        && (listVal.size() < 4 || isValidEmailStr(listVal[3]))
        && (listVal.size() < 5 || isValidEmailStr(listVal[4]))
        && (listVal.size() < 6 || isValidEmailStr(listVal[5]))
        && (listVal.size() < 7 || isValidEmailStr(listVal[6]))
        && (listVal.size() < 8 || isValidEmailStr(listVal[7]))
        && (listVal.size() < 9 || isValidEmailStr(listVal[8]))
        && (listVal.size() < 10 || isValidEmailStr(listVal[9]))
        && (listVal.size() < 11 || isValidEmailStr(listVal[10]))
        && (listVal.size() < 12 || isValidEmailStr(listVal[11]))
        && (listVal.size() < 13 || isValidEmailStr(listVal[12]))
        && (listVal.size() < 14 || isValidEmailStr(listVal[13]))
        && (listVal.size() < 15 || isValidEmailStr(listVal[14]));
    }

    function isValidShiftSchedule(s) {
      return s is map
        && s.keys().hasAll(['enabled', 'openingStart', 'openingEnd', 'closingStart', 'closingEnd'])
        && s.keys().hasOnly(['enabled', 'openingStart', 'openingEnd', 'closingStart', 'closingEnd'])
        && s.enabled is bool
        && isValidTimeStr(s.openingStart)
        && isValidTimeStr(s.openingEnd)
        && isValidTimeStr(s.closingStart)
        && isValidTimeStr(s.closingEnd)
        && (!s.enabled || (s.openingStart != s.openingEnd && s.closingStart != s.closingEnd));
    }

    // Hora oficial de Colombia (America/Bogota = UTC-5 fijo sin horario de verano)
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function toDateStr(ts) {
      return string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day());
    }

    function bogotaNow() {
      return request.time - duration.value(5, 'h');
    }

    function bogotaOpDateStr() {
      return toDateStr(request.time - duration.value(11, 'h'));
    }

    function bogotaPrevOpDateStr() {
      return toDateStr(request.time - duration.value(35, 'h'));
    }

    function bogotaMinutesNow() {
      return bogotaNow().hours() * 60 + bogotaNow().minutes();
    }

    function timeToMinutes(t) {
      return (t[0:1] == '0' ? int(t[1:2]) : int(t[0:2])) * 60
        + (t[3:4] == '0' ? int(t[4:5]) : int(t[3:5]));
    }

    function inWindowWithGrace(nowMin, startStr, endStr, graceMin) {
      return startStr != endStr
        && ((nowMin - timeToMinutes(startStr) + 1440) % 1440)
           < (((timeToMinutes(endStr) - timeToMinutes(startStr) + 1440) % 1440) + graceMin);
    }

    function isScheduleAllowed(s, nowMin) {
      return !s.enabled
        || inWindowWithGrace(nowMin, s.openingStart, s.openingEnd, 10)
        || inWindowWithGrace(nowMin, s.closingStart, s.closingEnd, 10);
    }

    function isValidWorkerOperationalDate(dateVal) {
      return dateVal == bogotaOpDateStr() || dateVal == bogotaPrevOpDateStr();
    }

    function isCurrentOperationalDate(dateVal) {
      return dateVal == bogotaOpDateStr();
    }

    function isWorkspaceWithinSchedule(wsData) {
      return !('shiftSchedule' in wsData)
        ? (
          inWindowWithGrace(bogotaMinutesNow(), '16:00', '18:00', 10)
          || inWindowWithGrace(bogotaMinutesNow(), '23:00', '02:00', 10)
        )
        : isScheduleAllowed(wsData.shiftSchedule, bogotaMinutesNow());
    }

    function isWorkerWithinSchedule(wsId) {
      return isWorkspaceWithinSchedule(
        get(/databases/$(database)/documents/workspaces/$(wsId)).data
      );
    }

    function hasActiveMemberDoc() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.active == true;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data;
    }

    function validWorkerMember(wsId, station, memberData) {
      return memberData.active == true
        && memberData.workspaceId == wsId
        && (
          memberData.station == station
          || (memberData.station == 'hamburguesas' && station == 'comida_rapida')
        );
    }

    function validWorkerMemberDoc(wsId, station, memberSnap) {
      return memberSnap != null
        && validWorkerMember(wsId, station, memberSnap.data);
    }

    function isActiveStationWorker(wsId, station) {
      return isVerifiedUser()
        && validWorkerMemberDoc(
          wsId,
          station,
          get(/databases/$(database)/documents/teamMembers/$(request.auth.uid))
        );
    }

    function validWorkerReportCreate(wsData, report) {
      return isWorkspaceWithinSchedule(wsData)
        && report.ownerUid == wsData.ownerUid;
    }

    function reportAfterMatchesEntry(reportData, entry) {
      return reportData.workspaceId == entry.workspaceId
        && reportData.ownerUid == entry.ownerUid
        && reportData.date == entry.date
        && reportData.station == entry.station;
    }

    function entryMatchesItem(entry, itemData) {
      return itemData.workspaceId == entry.workspaceId
        && (
          itemData.station == entry.station
          || (itemData.station == 'hamburguesas' && entry.station == 'comida_rapida')
        )
        && itemData.name == entry.itemName
        && itemData.unit == entry.unit
        && itemData.minStock == entry.minStock
        && itemData.targetStock == entry.targetStock;
    }

    function canCreateDailyReportEntry(reportAfterSnap, entry, itemId) {
      return reportAfterSnap != null
        && reportAfterMatchesEntry(reportAfterSnap.data, entry)
        && (
          (
            isActiveStationWorker(entry.workspaceId, entry.station)
            && reportAfterSnap.data.status != 'completed'
            && isValidWorkerOperationalDate(entry.date)
            && isWorkerWithinSchedule(entry.workspaceId)
            && entryMatchesItem(
              entry,
              get(/databases/$(database)/documents/items/$(itemId)).data
            )
          )
          || canManageWorkspace(entry.workspaceId)
        );
    }

    function canWorkerUpdateEntry(reportSnap, incomingData, existingData) {
      return isActiveStationWorker(existingData.workspaceId, existingData.station)
        && reportSnap != null
        && reportSnap.data.status != 'completed'
        && isValidWorkerOperationalDate(existingData.date)
        && isWorkerWithinSchedule(existingData.workspaceId)
        && incomingData.itemName == existingData.itemName
        && incomingData.unit == existingData.unit
        && incomingData.minStock == existingData.minStock
        && incomingData.targetStock == existingData.targetStock
        && incomingData.diff(existingData).affectedKeys().hasOnly([
          'opening', 'added', 'closing', 'hasOpening', 'hasClosing',
          'notApplicable', 'previousClosing', 'openingStatus',
          'updatedByUid', 'updatedByName', 'updatedAt'
        ]);
    }

    function isWorkspaceOwnerDoc(docData) {
      return isVerifiedUser() && (
        docData.ownerUid == request.auth.uid
        || isAdmin()
      );
    }

    function canManageWorkspace(wsId) {
      return isVerifiedUser() && (
        isAdmin()
        || wsId == 'ws_' + request.auth.uid
        || (
          exists(/databases/$(database)/documents/workspaces/$(wsId))
          && (
            get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerUid == request.auth.uid
            || request.auth.token.email in get(/databases/$(database)/documents/workspaces/$(wsId)).data.authorizedEmails
          )
        )
        || (
          hasActiveMemberDoc()
          && memberDoc().workspaceId == wsId
          && memberDoc().station == 'jefe'
        )
      );
    }

    function canManageReportId(reportId) {
      return isAdmin()
        || reportId.matches('^ws_' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-zA-Z0-9_\\-]+$')
        || (
          reportId.matches('^restaurante_principal_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-zA-Z0-9_\\-]+$')
          && canManageWorkspace('restaurante_principal')
        )
        || (
          hasActiveMemberDoc()
          && memberDoc().station == 'jefe'
          && reportId.matches('^' + memberDoc().workspaceId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-zA-Z0-9_\\-]+$')
        );
    }

    function canReportStation(wsId, station) {
      return canManageWorkspace(wsId) || (
        hasActiveMemberDoc()
        && memberDoc().workspaceId == wsId
        && memberDoc().station == station
      );
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'ownerEmail', 'authorizedEmails', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'ownerUid', 'ownerEmail', 'ownerName', 'shiftSchedule', 'authorizedEmails', 'seeded', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && isValidId(data.ownerUid)
        && isValidEmailStr(data.ownerEmail)
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80))
        && (!('shiftSchedule' in data) || isValidShiftSchedule(data.shiftSchedule))
        && isValidEmailList(data.authorizedEmails)
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkstation(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'name', 'area',
          'workerName', 'description', 'accessCode', 'nextItemSlot',
          'active', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'name', 'area',
          'workerName', 'description', 'accessCode', 'nextItemSlot', 'assignedItemIds',
          'active', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidEmailList(data.authorizedEmails)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.area is string && data.area.size() <= 60
        && data.workerName is string && data.workerName.size() >= 1 && data.workerName.size() <= 80
        && data.description is string && data.description.size() <= 200
        && isValidId(data.accessCode)
        && data.accessCode.size() >= 6 && data.accessCode.size() <= 64
        && data.nextItemSlot is number && data.nextItemSlot >= 1 && data.nextItemSlot <= 500
        && (!('assignedItemIds' in data) || (data.assignedItemIds is list && data.assignedItemIds.size() <= 150 && (data.assignedItemIds.size() == 0 || isValidId(data.assignedItemIds[0]))))
        && data.active is bool
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStationLink(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'stationId', 'stationName', 'workerName', 'active', 'createdAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'stationId', 'stationName', 'workerName', 'active', 'createdAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidId(data.stationId)
        && data.stationName is string && data.stationName.size() >= 1 && data.stationName.size() <= 80
        && data.workerName is string && data.workerName.size() >= 1 && data.workerName.size() <= 80
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'station', 'name',
          'unit', 'minStock', 'targetStock', 'active', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'station', 'name',
          'unit', 'minStock', 'targetStock', 'inputType', 'packSize', 'packLabel',
          'unitLabel', 'capacity', 'allowClosedContainers', 'active', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidEmailList(data.authorizedEmails)
        && isStationId(data.station)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24
        && data.minStock is number && data.minStock >= 0 && data.minStock <= 100000
        && data.targetStock is number && data.targetStock >= 0 && data.targetStock <= 100000
        && (!('inputType' in data) || (data.inputType is string && data.inputType in ['count', 'packs', 'level']))
        && (!('packSize' in data) || (data.packSize is int && data.packSize > 1 && data.packSize <= 10000))
        && (!('packLabel' in data) || (data.packLabel is string && data.packLabel.size() >= 1 && data.packLabel.size() <= 20))
        && (!('unitLabel' in data) || (data.unitLabel is string && data.unitLabel.size() >= 1 && data.unitLabel.size() <= 20))
        && (!('capacity' in data) || (data.capacity is number && data.capacity > 0 && data.capacity <= 100000))
        && (!('allowClosedContainers' in data) || (data.allowClosedContainers is bool && (!data.allowClosedContainers || ('inputType' in data && data.inputType == 'level'))))
        && (
          !('inputType' in data)
          || data.inputType == 'count'
          || (
            data.inputType == 'packs'
            && 'packSize' in data
            && 'packLabel' in data
            && 'unitLabel' in data
          )
          || (
            data.inputType == 'level'
            && 'capacity' in data
          )
        )
        && data.active is bool
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'date', 'station',
          'status', 'reportedByUid', 'reportedByName', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'date', 'station',
          'status', 'reportedByUid', 'reportedByName', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidEmailList(data.authorizedEmails)
        && isValidDateStr(data.date)
        && isStationId(data.station)
        && data.status is string && data.status in ['open', 'opening_saved', 'completed']
        && isValidId(data.reportedByUid)
        && data.reportedByName is string && data.reportedByName.size() >= 1 && data.reportedByName.size() <= 80
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyReportEntry(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'reportId', 'itemId',
          'station', 'date', 'itemName', 'unit', 'minStock', 'targetStock',
          'opening', 'added', 'closing', 'hasOpening', 'hasClosing',
          'updatedByUid', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'reportId', 'itemId',
          'station', 'date', 'itemName', 'unit', 'minStock', 'targetStock',
          'opening', 'added', 'closing', 'hasOpening', 'hasClosing', 'notApplicable',
          'previousClosing', 'openingStatus',
          'updatedByUid', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidEmailList(data.authorizedEmails)
        && isValidId(data.reportId)
        && isValidId(data.itemId)
        && isStationId(data.station)
        && isValidDateStr(data.date)
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 80
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24
        && data.minStock is number && data.minStock >= 0 && data.minStock <= 100000
        && data.targetStock is number && data.targetStock >= 0 && data.targetStock <= 100000
        && data.opening is number && data.opening >= 0 && data.opening <= 100000
        && data.added is number && data.added >= 0 && data.added <= 100000
        && data.closing is number && data.closing >= 0 && data.closing <= 100000
        && data.hasOpening is bool
        && data.hasClosing is bool
        && (!('notApplicable' in data) || data.notApplicable is bool)
        && (!('previousClosing' in data) || (data.previousClosing is number && data.previousClosing >= 0 && data.previousClosing <= 100000))
        && (!('openingStatus' in data) || (data.openingStatus is string && data.openingStatus in ['confirmed_match', 'adjusted', 'manual']))
        && isValidId(data.updatedByUid)
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['workspaceId', 'ownerUid', 'email', 'displayName', 'station', 'createdAt'])
        && data.keys().hasOnly(['workspaceId', 'ownerUid', 'email', 'displayName', 'station', 'createdAt'])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidEmailStr(data.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && isStationId(data.station)
        && data.createdAt is timestamp;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'uid', 'email', 'displayName',
          'station', 'inviteId', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'uid', 'email', 'displayName',
          'station', 'inviteId', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidId(data.uid)
        && isValidEmailStr(data.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && isStationId(data.station)
        && isValidId(data.inviteId)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkerNote(data) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'station',
          'authorUid', 'authorName', 'date', 'timeLabel', 'text',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'authorizedEmails', 'station',
          'authorUid', 'authorName', 'date', 'timeLabel', 'text',
          'itemId', 'itemName', 'itemUnit', 'quantity',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.workspaceId)
        && isValidId(data.ownerUid)
        && isValidEmailList(data.authorizedEmails)
        && isStationId(data.station)
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && isValidDateStr(data.date)
        && data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 16
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 200 && data.text.trim().size() >= 1
        && (!('itemId' in data) || isValidId(data.itemId))
        && (!('itemName' in data) || (data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 80))
        && (!('itemUnit' in data) || (data.itemUnit is string && data.itemUnit.size() >= 1 && data.itemUnit.size() <= 24))
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 0 && data.quantity <= 100000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerifiedUser() && adminUid == request.auth.uid;
      allow list, write: if false;
    }

    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && isVerifiedUser() && (
        workspaceId == 'ws_' + request.auth.uid
        || isAdmin()
        || (
          resource != null && (
            existing().ownerUid == request.auth.uid
            || request.auth.token.email in existing().authorizedEmails
            || (hasActiveMemberDoc() && memberDoc().workspaceId == workspaceId)
          )
        )
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email in resource.data.authorizedEmails
      );

      allow create: if isValidId(workspaceId)
        && isVerifiedUser()
        && isValidWorkspace(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (workspaceId == 'restaurante_principal' && isAdmin())
          || workspaceId == 'ws_' + request.auth.uid
        );

      allow update: if isValidId(workspaceId)
        && isVerifiedUser()
        && isValidWorkspace(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && canManageWorkspace(workspaceId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'ownerName', 'shiftSchedule', 'authorizedEmails', 'seeded', 'updatedAt']);

      allow delete: if false;
    }

    match /stations/{stationId} {
      allow get: if isValidId(stationId) && isVerifiedUser() && (
        (
          resource == null
          && (
            isAdmin()
            || (
              hasActiveMemberDoc()
              && (memberDoc().station == stationId || memberDoc().station == 'jefe')
            )
          )
        )
        || (
          resource != null && (
            isAdmin()
            || existing().ownerUid == request.auth.uid
            || request.auth.token.email in existing().authorizedEmails
            || (
              hasActiveMemberDoc()
              && memberDoc().workspaceId == existing().workspaceId
              && (memberDoc().station == stationId || memberDoc().station == 'jefe')
            )
          )
        )
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email in resource.data.authorizedEmails
      );

      allow create: if isValidId(stationId)
        && isVerifiedUser()
        && isValidWorkstation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
        && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
        && canManageWorkspace(incoming().workspaceId);

      allow update: if isValidId(stationId)
        && isVerifiedUser()
        && isValidWorkstation(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && canManageWorkspace(existing().workspaceId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorizedEmails', 'name', 'area', 'workerName', 'description',
          'accessCode', 'nextItemSlot', 'assignedItemIds', 'active', 'sortOrder', 'updatedAt'
        ]);

      allow delete: if isValidId(stationId)
        && isWorkspaceOwnerDoc(existing());
    }

    match /stationLinks/{accessCode} {
      // Preview mínimo público para mostrar nombre del puesto/trabajadora antes de entrar con Google
      allow get: if isValidId(accessCode) && accessCode.size() >= 6 && accessCode.size() <= 64;
      allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(accessCode)
        && accessCode.size() >= 16
        && accessCode.size() <= 64
        && isVerifiedUser()
        && isValidStationLink(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
        && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
        && canManageWorkspace(incoming().workspaceId);

      allow update: if isValidId(accessCode)
        && isVerifiedUser()
        && isValidStationLink(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().stationId == existing().stationId
        && incoming().createdAt == existing().createdAt
        && canManageWorkspace(existing().workspaceId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['stationName', 'workerName', 'active']);

      allow delete: if isValidId(accessCode)
        && (
          isWorkspaceOwnerDoc(existing())
          || (isVerifiedUser() && canManageWorkspace(existing().workspaceId))
        );
    }

    match /items/{itemId} {
      allow get: if isValidId(itemId) && isVerifiedUser() && (
        (
          resource == null
          && (
            isAdmin()
            || (
              hasActiveMemberDoc()
              && (memberDoc().station == 'jefe' || itemId.matches('^' + memberDoc().station + '_[0-9]+$'))
            )
          )
        )
        || (
          resource != null && (
            isAdmin()
            || existing().ownerUid == request.auth.uid
            || request.auth.token.email in existing().authorizedEmails
            || (
              hasActiveMemberDoc()
              && memberDoc().workspaceId == existing().workspaceId
              && (
                memberDoc().station == existing().station
                || (existing().station == 'hamburguesas' && memberDoc().station == 'comida_rapida')
                || memberDoc().station == 'jefe'
              )
            )
          )
        )
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email in resource.data.authorizedEmails
      );

      allow create: if isValidId(itemId)
        && isVerifiedUser()
        && isValidInventoryItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
        && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
        && canManageWorkspace(incoming().workspaceId);

      allow update: if isValidId(itemId)
        && isVerifiedUser()
        && isValidInventoryItem(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && canManageWorkspace(existing().workspaceId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorizedEmails', 'station', 'name', 'unit',
          'minStock', 'targetStock', 'inputType', 'packSize', 'packLabel',
          'unitLabel', 'capacity', 'allowClosedContainers', 'active', 'sortOrder', 'updatedAt'
        ]);

      allow delete: if isValidId(itemId)
        && isWorkspaceOwnerDoc(existing());
    }

    match /dailyReports/{reportId} {
      allow get: if isValidId(reportId) && isVerifiedUser() && (
        (
          resource == null
          && (
            canManageReportId(reportId)
            || (
              hasActiveMemberDoc()
              && reportId.matches('^' + memberDoc().workspaceId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_' + memberDoc().station + '$')
            )
          )
        )
        || (
          resource != null && (
            isAdmin()
            || existing().ownerUid == request.auth.uid
            || request.auth.token.email in existing().authorizedEmails
            || (
              hasActiveMemberDoc()
              && memberDoc().workspaceId == existing().workspaceId
              && (memberDoc().station == existing().station || memberDoc().station == 'jefe')
            )
          )
        )
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email in resource.data.authorizedEmails
      );

      allow create: if isValidId(reportId)
        && isVerifiedUser()
        && isValidDailyReport(incoming())
        && reportId == incoming().workspaceId + '_' + incoming().date + '_' + incoming().station
        && incoming().reportedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            isActiveStationWorker(incoming().workspaceId, incoming().station)
            && isValidWorkerOperationalDate(incoming().date)
            && validWorkerReportCreate(
              get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data,
              incoming()
            )
          )
          || (
            canManageWorkspace(incoming().workspaceId)
            && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
            && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
          )
        );

      allow update: if isValidId(reportId)
        && isVerifiedUser()
        && isValidDailyReport(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().date == existing().date
        && incoming().station == existing().station
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isActiveStationWorker(existing().workspaceId, existing().station)
            && existing().status != 'completed'
            && isValidWorkerOperationalDate(existing().date)
            && isWorkerWithinSchedule(existing().workspaceId)
            && incoming().reportedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reportedByUid', 'reportedByName', 'notes', 'updatedAt'
            ])
          )
          || (
            canManageWorkspace(existing().workspaceId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorizedEmails', 'status', 'reportedByUid', 'reportedByName', 'notes', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(reportId)
        && isWorkspaceOwnerDoc(existing());

      match /entries/{itemId} {
        allow get: if isValidId(reportId)
          && isValidId(itemId)
          && isVerifiedUser()
          && (
            (
              resource == null
              && (
                canManageReportId(reportId)
                || (
                  hasActiveMemberDoc()
                  && reportId.matches('^' + memberDoc().workspaceId + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_' + memberDoc().station + '$')
                )
              )
            )
            || (
              resource != null
              && exists(/databases/$(database)/documents/dailyReports/$(reportId))
              && (
                isAdmin()
                || existing().ownerUid == request.auth.uid
                || request.auth.token.email in existing().authorizedEmails
                || (
                  hasActiveMemberDoc()
                  && memberDoc().workspaceId == existing().workspaceId
                  && (memberDoc().station == existing().station || memberDoc().station == 'jefe')
                )
              )
            )
          );

        allow list: if isVerifiedUser() && (
          resource.data.ownerUid == request.auth.uid
          || request.auth.token.email in resource.data.authorizedEmails
        );

        allow create: if isValidId(reportId)
          && isValidId(itemId)
          && isVerifiedUser()
          && isValidDailyReportEntry(incoming())
          && incoming().reportId == reportId
          && incoming().itemId == itemId
          && incoming().updatedByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && canCreateDailyReportEntry(
            exists(/databases/$(database)/documents/dailyReports/$(reportId))
              ? get(/databases/$(database)/documents/dailyReports/$(reportId))
              : getAfter(/databases/$(database)/documents/dailyReports/$(reportId)),
            incoming(),
            itemId
          );

        allow update: if isValidId(reportId)
          && isValidId(itemId)
          && isVerifiedUser()
          && isValidDailyReportEntry(incoming())
          && incoming().workspaceId == existing().workspaceId
          && incoming().ownerUid == existing().ownerUid
          && incoming().reportId == existing().reportId
          && incoming().itemId == existing().itemId
          && incoming().station == existing().station
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().updatedByUid == request.auth.uid
          && (
            canWorkerUpdateEntry(
              get(/databases/$(database)/documents/dailyReports/$(reportId)),
              incoming(),
              existing()
            )
            || (
              canManageWorkspace(existing().workspaceId)
              && exists(/databases/$(database)/documents/dailyReports/$(reportId))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'authorizedEmails', 'opening', 'added', 'closing', 'hasOpening', 'hasClosing',
                'notApplicable', 'previousClosing', 'openingStatus',
                'itemName', 'unit', 'minStock', 'targetStock',
                'updatedByUid', 'updatedByName', 'updatedAt'
              ])
            )
          );

        allow delete: if isValidId(reportId)
          && isValidId(itemId)
          && isWorkspaceOwnerDoc(existing());
      }
    }

    match /invites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerifiedUser() && (
        existing().ownerUid == request.auth.uid
        || existing().email == request.auth.token.email
        || canManageWorkspace(existing().workspaceId)
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.email == request.auth.token.email
      );

      allow create: if isValidId(inviteId)
        && isVerifiedUser()
        && isValidInvite(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
        && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
        && canManageWorkspace(incoming().workspaceId);

      allow update: if isValidId(inviteId)
        && isVerifiedUser()
        && isValidInvite(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && canManageWorkspace(existing().workspaceId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'station']);

      allow delete: if isValidId(inviteId)
        && (
          isWorkspaceOwnerDoc(existing())
          || (isVerifiedUser() && canManageWorkspace(existing().workspaceId))
        );
    }

    match /teamMembers/{memberId} {
      allow get: if isValidId(memberId) && isVerifiedUser() && (
        memberId == request.auth.uid
        || (
          resource != null && (
            existing().ownerUid == request.auth.uid
            || existing().uid == request.auth.uid
            || canManageWorkspace(existing().workspaceId)
          )
        )
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.uid == request.auth.uid
      );

      allow create: if isValidId(memberId)
        && isVerifiedUser()
        && isValidTeamMember(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
        && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
        && (
          canManageWorkspace(incoming().workspaceId)
          || (
            memberId == request.auth.uid
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().active == true
            && (
              (
                exists(/databases/$(database)/documents/invites/$(incoming().inviteId))
                && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.email == request.auth.token.email
                && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.workspaceId == incoming().workspaceId
                && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.station == incoming().station
              )
              || (
                exists(/databases/$(database)/documents/stationLinks/$(incoming().inviteId))
                && get(/databases/$(database)/documents/stationLinks/$(incoming().inviteId)).data.active == true
                && get(/databases/$(database)/documents/stationLinks/$(incoming().inviteId)).data.workspaceId == incoming().workspaceId
                && get(/databases/$(database)/documents/stationLinks/$(incoming().inviteId)).data.stationId == incoming().station
              )
            )
          )
        );

      allow update: if isValidId(memberId)
        && isVerifiedUser()
        && isValidTeamMember(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            canManageWorkspace(existing().workspaceId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'station', 'active', 'updatedAt'])
          )
          || (
            memberId == request.auth.uid
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && existing().active == true
            && incoming().active == true
            && incoming().station == existing().station
            && incoming().diff(existing()).affectedKeys().hasOnly(['inviteId', 'displayName', 'updatedAt'])
            && exists(/databases/$(database)/documents/stationLinks/$(incoming().inviteId))
            && get(/databases/$(database)/documents/stationLinks/$(incoming().inviteId)).data.active == true
            && get(/databases/$(database)/documents/stationLinks/$(incoming().inviteId)).data.workspaceId == existing().workspaceId
            && get(/databases/$(database)/documents/stationLinks/$(incoming().inviteId)).data.stationId == existing().station
          )
        );

      allow delete: if isValidId(memberId)
        && isWorkspaceOwnerDoc(existing());
    }

    match /workerNotes/{noteId} {
      allow get: if isValidId(noteId) && isVerifiedUser() && (
        (resource == null && isAdmin())
        || (
          resource != null && (
            isAdmin()
            || existing().ownerUid == request.auth.uid
            || request.auth.token.email in existing().authorizedEmails
            || canManageWorkspace(existing().workspaceId)
            || isActiveStationWorker(existing().workspaceId, existing().station)
          )
        )
      );

      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email in resource.data.authorizedEmails
        || resource.data.authorUid == request.auth.uid
      );

      allow create: if isValidId(noteId)
        && isVerifiedUser()
        && isValidWorkerNote(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isCurrentOperationalDate(incoming().date)
        && isActiveStationWorker(incoming().workspaceId, incoming().station)
        && exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId))
        && incoming().ownerUid == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerUid
        && incoming().authorizedEmails == get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.authorizedEmails;

      allow update: if isValidId(noteId)
        && isVerifiedUser()
        && isValidWorkerNote(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().station == existing().station
        && incoming().authorUid == existing().authorUid
        && incoming().authorName == existing().authorName
        && incoming().date == existing().date
        && incoming().timeLabel == existing().timeLabel
        && incoming().createdAt == existing().createdAt
        && (
          (
            isActiveStationWorker(existing().workspaceId, existing().station)
            && existing().authorUid == request.auth.uid
            && isCurrentOperationalDate(existing().date)
            && incoming().authorizedEmails == existing().authorizedEmails
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'text', 'itemId', 'itemName', 'itemUnit', 'quantity', 'updatedAt'
            ])
          )
          || (
            canManageWorkspace(existing().workspaceId)
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['authorizedEmails', 'updatedAt'])
          )
        );

      allow delete: if isValidId(noteId)
        && isVerifiedUser()
        && (
          isWorkspaceOwnerDoc(existing())
          || canManageWorkspace(existing().workspaceId)
          || (
            isActiveStationWorker(existing().workspaceId, existing().station)
            && existing().authorUid == request.auth.uid
            && isCurrentOperationalDate(existing().date)
          )
        );
    }
  }
}
